# Print the MTP URIs of connected devices
_mtp_devices() {
    gio mount -li |
        sed -nE 's/^[[:space:]]*(activation_root|default_location)=(mtp:\/\/.*)$/\2/p' |
        sort -u
}

# Mount all connected MTP devices
connect() {
    local uris uri mount_dir
    uris="$(_mtp_devices)"

    if [[ -z "$uris" ]]; then
        echo "❌ No MTP phone detected."
        echo "Unlock it and select USB → File Transfer."
        return 1
    fi

    while IFS= read -r uri; do
        [[ -z "$uri" ]] && continue

        if gio mount "$uri" 2>/dev/null; then
            echo "✅ Connected: $uri"
        elif gio list "$uri" >/dev/null 2>&1; then
            echo "✅ Already connected: $uri"
        else
            echo "❌ Failed: $uri"
        fi
    done <<< "$uris"

    mount_dir="$(
        find "/run/user/$UID/gvfs" \
            -mindepth 1 -maxdepth 1 \
            -name 'mtp:*' -print -quit 2>/dev/null
    )"

    if [[ -n "$mount_dir" && -d "$mount_dir" ]]; then
        cd -- "$mount_dir" || return 1
        echo "📱 Entered: $PWD"
        ls
    else
        echo "❌ Phone mounted, but mount directory was not found."
        return 1
    fi
}

# Unmount all connected MTP devices
disconnect() {
    local uri found=0

    if [[ "$PWD" == /run/user/$UID/gvfs/mtp:* ]]; then
        cd ~
    fi

    while IFS= read -r uri; do
        [[ -z "$uri" ]] && continue

        if gio mount -u "$uri" 2>/dev/null; then
            echo "✅ Disconnected: $uri"
            found=1
        fi
    done <<< "$(_mtp_devices)"

    (( found )) || echo "No mounted MTP phone found."
}
gorg() {
  read -q "REPLY?⚠️ Reset to origin/main and DELETE all local changes? (y/n) "
  echo
  [[ $REPLY == "y" ]] && git fetch origin && git reset --hard origin/main
}

killport() {
  if [[ -z "$1" ]]; then
    echo "Usage: killport <port>"
  else
    kill -9 "$(lsof -ti :"$1")" 2>/dev/null && \
    echo "✔ Killed process on port $1" || echo "No process found"
  fi
}

function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}
crun() {
  local file="$1"
  [[ -z "$file" ]] && echo "Usage: crun <file.cpp>" && return 1
  local output="${file%.*}"
  g++ "$file" -o "$output" && "./$output"
}

czsync() {
  msg="${1:-update dotfiles}"
  chezmoi status | awk '{print $2}' | xargs -r chezmoi add
  chezmoi git add .
  chezmoi git commit -- -m "$msg"
  chezmoi git push
}

